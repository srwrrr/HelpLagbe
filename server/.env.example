PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
# Set DATABASE_URL for hosted MySQL, or use the split DB_* values below.
# DATABASE_URL=mysql://user:password@host:3306/helplagbe
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=helplagbe
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret-for-production
NODE_ENV=development
